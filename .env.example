# Environment
NODE_ENV=development
WEBSITE_URL=http://localhost:3000
APPLICATION_ID=

# Better Auth - Configuration
BETTER_AUTH_SECRET=

# Database (Turso/LibSQL)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Gateway Configuration
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Payments and tracking
AUTUMN_SECRET_KEY=

# ZeptoMail transactional email
# Generate this in ZeptoMail: Agent > SMTP/API > Send Mail Token.
ZEPTOMAIL_SEND_MAIL_TOKEN=
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_FROM_EMAIL=pioneer@rhemanigeria.com
ZEPTOMAIL_FROM_NAME=Rhema Nigeria - Vision 2040
ZEPTOMAIL_REPLY_TO_EMAIL=pioneer@rhemanigeria.com
ZEPTOMAIL_REPLY_TO_NAME=Rhema Nigeria - Vision 2040

# Form notification recipients
PIONEER_NOTIFY_TO_EMAIL=pioneer@rhemanigeria.com
PIONEER_NOTIFY_TO_NAME=Rhema Nigeria - Vision 2040
